# Hardware target test1 init.rc, reference build/test target.

setVersion major 1
setVersion minor 11
setModuleCountMax 9
setErrorCountMax 255

# System core
addModule driver timerContext -run none -source_file hal/mcu/atmega2560/at2560_timerContext.c
addModule driver usart -run none -source_file hal/mcu/atmega2560/at2560_usart.c

addModule service system -run core -stack 256 -source_file system/services/system.c

# Drivers
addModule driver i2c -run core -source_file hal/mcu/atmega2560/at2560_i2c.c

addModule driver lcd -run driver -i2c 0x3C -source_file hal/drivers/lcd/lcd_AMC2004.c
addModule driver rtc -run driver -i2c 0x68 -source_file hal/drivers/rtc/rtc_ZS042.c

# Services
addModule service scli -run service -stack 256 -source_file system/services/scli.c
addScliCommand date -source_file system/services/commands/scli_date.c
addScliCommand driver -source_file system/services/commands/scli_driver.c
addScliCommand i2c -source_file system/services/commands/scli_i2c.c
addScliCommand stack -source_file system/services/commands/scli_stack.c
addScliCommand thread -source_file system/services/commands/scli_thread.c

# Tasks
addModule task task1 -run user -stack 100 -source_file user/tasks/task1.c
addModule task task2 -run user -stack 100 -source_file user/tasks/task2.c
