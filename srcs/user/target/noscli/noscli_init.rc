setVersion major 1
setVersion minor 9
# Hardware target noscli init.rc

# System core, 
addModule driver timerSched -run none -source_file hal/mcu/atmega2560/at2560_timerSched.c
addModule driver timerSTC -run core -source_file hal/mcu/atmega2560/at2560_timerSTC.c
addModule driver usart -run none -source_file hal/mcu/atmega2560/at2560_usart.c

addModule service system -run core -stack 234 -source_file system/services/system.c

# Drivers
addModule driver i2c -run core -source_file hal/mcu/atmega2560/at2560_i2c.c

addModule driver lcd -run driver -i2c 0x3C -source_file hal/drivers/lcd/lcd_AMC2004.c
addModule driver rtc -run driver -i2c 0x68 -source_file hal/drivers/rtc/rtc_ZS042.c

# Services

# Tasks
addModule task task1 -run user -stack 50 -source_file user/tasks/task1.c
addModule task task2 -run user -stack 50 -source_file user/tasks/task2.c
