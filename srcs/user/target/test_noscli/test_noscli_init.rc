!set_version_major 1
!set_version_minor 4
# Hardware target test_noscli init.rc

# System core
timerSched -type driver -run none -source_file hal/mcu/atmega2560/at2560_timerSched.c
timerSTC -type driver -run core -source_file hal/mcu/atmega2560/at2560_timerSTC.c
usart -type driver -run none -source_file hal/mcu/atmega2560/at2560_usart.c

system -type service -run core -source_file system/services/system.c

# Drivers
i2c -type driver -run core -source_file hal/mcu/atmega2560/at2560_i2c.c

lcd -type driver -run driver -i2c 0x3C -source_file hal/drivers/lcd_AMC2004/lcd_AMC2004.c
rtc -type driver -run driver -i2c 0x68 -source_file hal/drivers/rtc_ZS042/rtc_ZS042.c

# Services

# Tasks
task1 -type user -run user -source_file user/tasks/task1.c
task2 -type user -run user -source_file user/tasks/task2.c
