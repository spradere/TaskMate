setVersion major 1
setVersion minor 8
# FreeBSD ucontext simulation init.rc

# Virtual HAL drivers
addModule driver timerSched -run none -source_file hal/host/freebsd/freebsd_timerSched.c
addModule driver timerSTC -run core -source_file hal/host/freebsd/freebsd_timerSTC.c
addModule driver usart -run none -source_file hal/host/freebsd/freebsd_usart.c

# The current HAL context contract requires one uniform target stack size.
addModule service system -run core -stack 32768 -source_file user/target/ucontext/ucontext_system.c

# SCLI commands supported by the minimal virtual HAL.
addModule service scli -run service -stack 32768 -source_file system/services/scli.c -source_file user/target/ucontext/ucontext_scli_commands.c

# Demonstration tasks
addModule task task1 -run user -stack 32768 -source_file user/tasks/task1.c
addModule task task2 -run user -stack 32768 -source_file user/tasks/task2.c
