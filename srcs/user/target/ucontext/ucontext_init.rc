!set_initrc_ver_major 1
!set_initrc_ver_minor 6
# FreeBSD ucontext simulation init.rc

# Virtual HAL drivers
addDriver timerSched -run none -source_file hal/host/freebsd/freebsd_timerSched.c
addDriver timerSTC -run core -source_file hal/host/freebsd/freebsd_timerSTC.c
addDriver usart -run none -source_file hal/host/freebsd/freebsd_usart.c

# The current HAL context contract requires one uniform target stack size.
addService system -run core -stack 32768 -source_file user/target/ucontext/ucontext_system.c

# SCLI commands supported by the minimal virtual HAL.
addService scli -run service -stack 32768 -source_file system/services/scli.c -source_file user/target/ucontext/ucontext_scli_commands.c

# Demonstration tasks
addTask task1 -run user -stack 32768 -source_file user/tasks/task1.c
addTask task2 -run user -stack 32768 -source_file user/tasks/task2.c
