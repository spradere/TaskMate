enum
{

    HAVE_ARCH, HAVE_MCU, HAVE_BOARD, HAVE_ERRORS, HAVE_HAL_USER, HAVE_HAL_SYSTEM,

    HAVE_COUNT
} have_options_id;

static const char *have_to_string[HAVE_COUNT] =
{

    [HAVE_ARCH] = "--arch", [HAVE_MCU] = "--mcu", [HAVE_BOARD] = "--board", [HAVE_ERRORS] = "--errors", [HAVE_HAL_USER] = "--files_hal_user", [HAVE_HAL_SYSTEM] = "--files_hal_sytsem",

};

static int have_options_count[HAVE_COUNT];

static char *string_from_have(char *string, const int id)
{

    if(id == HAVE_ARCH){return have_to_string[HAVE_ARCH];}
    if(id == HAVE_MCU){return have_to_string[HAVE_MCU];}
    if(id == HAVE_BOARD){return have_to_string[HAVE_BOARD];}
    if(id == HAVE_ERRORS){return have_to_string[HAVE_ERRORS];}
    if(id == HAVE_HAL_USER){return have_to_string[HAVE_HAL_USER];}
    if(id == HAVE_HAL_SYSTEM){return have_to_string[HAVE_HAL_SYSTEM];}

    return 0;
}

static void funcArch(const char *value, options_list_t *opt)
{
 strncpy(opt->arch_name, value, 256);
 have_options_count[HAVE_ARCH]++;
}

static void funcMcu(const char *value, options_list_t *opt)
{
 strncpy(opt->mcu_name, value, 256);
 have_options_count[HAVE_MCU]++;
}

static void funcBoard(const char *value, options_list_t *opt)
{
 strncpy(opt->board_name, value, 256);
 have_options_count[HAVE_BOARD]++;
}

static void funcErrors(const char *value, options_list_t *opt)
{
 strncpy(opt->errors_file, value, 256);
 have_options_count[HAVE_ERRORS]++;
}

static void funcHalUser(const char *value, options_list_t *opt)
{
 strncpy(opt->files_hal_user, value, 256);
 have_options_count[HAVE_HAL_USER]++;
}

static void funcHalSystem(const char *value, options_list_t *opt)
{
 strncpy(opt->files_hal_system, value, 256);
 have_options_count[HAVE_HAL_SYSTEM]++;
}

static const struct
{
 const char *name;
 void (*func)(const char *value, options_list_t *opt);

} options_cmds[] = {{"--arch", funcArch},
     {"--mcu", funcMcu},
     {"--board", funcBoard},
     {"--errors", funcErrors},
     {"--files_hal_user", funcHalUser},
     {"--files_hal_system", funcHalSystem},
     {((void *)0), ((void *)0)}};

static int optionCmdDispatch(const char *cmd, const char *value, options_list_t *opt)
{
 for( int i = 0; options_cmds[i].name != ((void *)0); i++ )
 {
  if( strcmp(cmd, options_cmds[i].name) == 0 )
  {
   (*options_cmds[i].func)(value, opt);
   return 0;
  }
 }
 return -1;
}

void options(const char *file_name, options_list_t *opt)
{

 for(i=0; i<have_count; i++)
 {
  have_options_count[i]=0;
 }


 file_t file;
 fileInit(&file);
 file.name = (char *)file_name;
 fileOpen(&file, "r", "src/autoCode/options.c", 131);

 int file_line_number = 0;
 tokenizer_t tok;

 while( fgets(tok.line, 256, file.stream) )
 {
  file_line_number++;
  tokenizer(&tok);

  if( tok.count != 2 )
  {
   fprintf(__stderrp, "[%s:%d] error : " "wrong token count [%s:%i] is %i, should be 1" "\n", "options.c", 143, file.name, file_line_number, tok.count); perror("\t");
   exit(1);
  }

  fprintf(__stdoutp, "[%s] info : " " parsing %s = %s" "\n", "options.c", tok.tokens[0], tok.tokens[1]);

  int err = optionCmdDispatch(tok.tokens[0], tok.tokens[1], opt);

  if( err != 0 )
  {
   fprintf(__stderrp, "[%s:%d] error : " "unknown option [%s:%i] %s\n" "\n", "options.c", 153, file.name, file_line_number, tok.tokens[0]); perror("\t");
   exit(1);
  }
 }


 for(i=0; i<have_count; i++)
 {
  if(have_options_count[i] == 0)
   {
    fprintf(__stderrp, "[%s:%d] error : " "required option %s is not set" "\n", "options.c", 163, string_from_have(i)); perror("\t");
    exit(0);
   }

  if(have_options_count[i] > 1)
   {
    fprintf(__stderrp, "[%s:%d] error : " "required option %s is multiple set" "\n", "options.c", 169, string_from_have(i)); perror("\t");
    exit(0);
   }
 }


