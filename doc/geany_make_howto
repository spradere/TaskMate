open a file a a given line :
	geany +NUM_LINE file.c

using ~/bin/go select/paste error from compiler output
	go path/file.c:48

open all files
	geany $(find . -type f -name '*.h')
	find . -type f \( -name "*.c" -o -name "*.h" \) -print0 | xargs -0 geany &

display a make variable
	make -V VAR_NAME
