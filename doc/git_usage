normal save :
	git add .
	git commit -m "comment"
	git push

delete local : git branch -d test_branch
delete remote : git push origin --delete test_branch

list last commits :
	git log --oneline

list local / remonte branch
	git branch -a --sort=-committerdate

check tag
	git ls-remote --tags origin

check commits
	git rev-list --count v0.5
