Checks: >
  clang-analyzer-*,
  -clang-analyzer-cplusplus.*,
  -clang-analyzer-security.*,
  bugprone-*,
  readability-*,
  -readability-braces-around-statements,
  performance-*,
  -modernize-*,
  -cppcoreguidelines-*

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '30'

HeaderFilterRegex: ^src/
WarningsAsErrors: false
FormatStyle: file
